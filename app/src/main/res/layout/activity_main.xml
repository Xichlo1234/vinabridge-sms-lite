<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chuyển tiếp SMS an toàn qua Firebase cá nhân"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái hệ thống"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_auth_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Firebase: Chưa đăng nhập"
                    android:textColor="@color/warning"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_pairing_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bảo mật: Chưa nhập mã khóa ghép cặp"
                    android:textColor="@color/error"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Mode Selection Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chọn chế độ hoạt động"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <!-- Mode Gateway Button -->
        <Button
            android:id="@+id/btn_mode_gateway"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="1. Máy gửi SMS (Gateway tại VN)"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />

        <!-- Mode Receiver Button -->
        <Button
            android:id="@+id/btn_mode_receiver"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="2. Máy nhận SMS (Receiver ở nước ngoài)"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/success"
            android:textColor="#FFFFFF" />

        <!-- Settings & Pairing Button -->
        <Button
            android:id="@+id/btn_settings_pairing"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="Cấu hình Firebase & Ghép cặp"
            android:textSize="14sp"
            android:backgroundTint="@color/accent"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
